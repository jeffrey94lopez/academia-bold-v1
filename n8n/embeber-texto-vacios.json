    "body": "={{ JSON.stringify({ instances: [ { content: $json.text } ] }) }}",
    "options": {}
   }
  },
  {
   "id": "n4",
   "name": "Respuesta OK",
   "type": "n8n-nodes-base.respondToWebhook",

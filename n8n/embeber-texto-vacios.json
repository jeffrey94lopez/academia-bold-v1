     "name": "Vertex - BoldBot"
    }
   },
   "parameters": {
    "method": "POST",
    "url": "https://us-central1-aiplatform.googleapis.com/v1/projects/gen-lang-client-0047287949/locations/us-central1/publishers/google/models/text-multilingual-embedding-002:predict",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "googleApi",
    "sendBody": true,
    "contentType": "raw",

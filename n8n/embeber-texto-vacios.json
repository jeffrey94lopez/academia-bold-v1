    120
   ],
   "parameters": {
    "respondWith": "json",
    "responseBody": "={{ (() => { const e = $json.error; const m = (typeof e === 'string' ? e : (e && e.message)) || $json.message || ''; if (m.includes('unauthorized')) return JSON.stringify({ error: 'unauthorized', message: 'x-api-key invalido o ausente' }); if (m.includes('validation_error')) return JSON.stringify({ error: 'validation_error', message: 'text requerido' }); return JSON.stringify({ error: 'upstream_error', message: 'el servicio de embeddings fallo' }); })() }}",
    "options": {

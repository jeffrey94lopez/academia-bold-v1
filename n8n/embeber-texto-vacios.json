   "onError": "continueErrorOutput",
   "parameters": {
    "jsCode": "const body = $input.first().json.body; const token = $input.first().json.headers?.['x-api-key']; if (!token || token !== 'BoldBodi-***TOKEN***') { throw new Error('unauthorized'); } const text = typeof body?.text === 'string' ? body.text.trim() : ''; if (!text) { throw new Error('validation_error'); } return [{ json: { text } }];"
   }
  },
  {
   "id": "n3",
   "name": "Generar embedding",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    440,
